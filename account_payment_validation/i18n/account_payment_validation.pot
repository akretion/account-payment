#. module: account_payment_validation
#: model:mail.template,body_html:account_payment_validation.payment_validation_level1_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Hello <t t-out=\"object.payment_validation_level1_user_id.name\"/>,</p>\n"
"                <p>The vendor bill <b t-out=\"object.name\"/> (<t t-out=\"object.partner_id.display_name\"/>) is waiting for your approval to be paid.</p>\n"
"\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; width: 100%; text-align: center; margin-bottom: 16px;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Bill Date</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Due Date</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Total</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Reference</th>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.invoice_date or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.invoice_date_due or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.amount_total or ''\"/>\n"
"                            <t t-out=\"object.currency_id.name or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.ref or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <a t-attf-href=\"/odoo/action-account.action_move_in_invoice_type/{{object.id}}\" style=\"background-color:#875A7B; padding:8px 16px; text-decoration:none; color:#fff; border-radius:5px;\">Open the vendor bill</a>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <t t-if=\"user.signature\">\n"
"                    <p>\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </p>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""

