"                        <th style=\"padding: 5px; border: 1px solid black;\">Référence</th>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.invoice_date or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.invoice_date_due or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.amount_total or ''\"/>\n"
"                            <t t-out=\"object.currency_id.name or ''\"/>\n"
"                        </td>\n"
"                        <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                            <t t-out=\"object.ref or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <a t-attf-href=\"/odoo/action-account.action_move_in_invoice_type/{{object.id}}\" style=\"background-color:#875A7B; padding:8px 16px; text-decoration:none; color:#fff; border-radius:5px;\">Ouvrir la facture fournisseur</a>\n"
