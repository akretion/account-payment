msgstr "En attente de validation du paiement (niveau 1)"

#. module: account_payment_validation
#: model:ir.model.fields.selection,name:account_payment_validation.selection__account_move__status_in_payment__to_validate_level2
msgid "Waiting Payment Approval (Level 2)"
msgstr "En attente de validation du paiement (niveau 2)"

