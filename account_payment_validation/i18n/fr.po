#: model:ir.model.fields,field_description:account_payment_validation.field_account_bank_statement_line__status_in_payment
#: model:ir.model.fields,field_description:account_payment_validation.field_account_move__status_in_payment
msgid "Status In Payment"
msgstr "Statut du paiement"

#. module: account_payment_validation
#: model:ir.model.fields,help:account_payment_validation.field_account_bank_statement_line__payment_validation_step
#: model:ir.model.fields,help:account_payment_validation.field_account_move__payment_validation_step
#: model:ir.model.fields,help:account_payment_validation.field_account_move_line__payment_validation_step
msgid "Step of the approval of the payment of this document by the approvers. It starts when the vendor bill is validated (posted)."
msgstr "Étape de la validation de l'envoi en paiement de ce document par les validateurs. Elle démarre lorsque la facture fournisseur est validée (comptabilisée)."

#. module: account_payment_validation
#. odoo-python
#: code:addons/account_payment_validation/models/account_move.py:0
msgid "The level 2 approver must be set on %s before validating the bill."
msgstr "Le validateur du paiement de niveau 2 doit être renseigné sur %s avant de valider la facture."

#. module: account_payment_validation
#. odoo-python
#: code:addons/account_payment_validation/models/account_move.py:0
msgid "There is no payment approval request to send for %s."
msgstr "Il n'y a aucune demande de validation du paiement à envoyer pour %s."

#. module: account_payment_validation
#. odoo-python
#: code:addons/account_payment_validation/models/account_move.py:0
msgid "There is no pending payment approval request on %s."
msgstr "Il n'y a aucune demande de validation du paiement en attente sur %s."

#. module: account_payment_validation
#: model:ir.model.fields,help:account_payment_validation.field_account_bank_statement_line__payment_validation_level1_user_id
#: model:ir.model.fields,help:account_payment_validation.field_account_move__payment_validation_level1_user_id
msgid "User of the group 'Payment Approval: Level 1 Approvers' who must approve the payment of this document (first step). This step is optional: when no level 1 approver is set, the payment approval is directly requested to the level 2 approver. It is defaulted from the partner of the document and can be changed here."
msgstr "Utilisateur du groupe « Bon à payer : validateurs niveau 1 » qui doit valider l'envoi en paiement de ce document (première étape). Cette étape est facultative : lorsqu'aucun validateur de niveau 1 n'est renseigné, la demande de validation du paiement est envoyée directement au validateur de niveau 2. Il est proposé par défaut depuis le partenaire du document et peut être modifié ici."

#. module: account_payment_validation
#: model:ir.model.fields,help:account_payment_validation.field_account_bank_statement_line__payment_validation_level2_user_id
#: model:ir.model.fields,help:account_payment_validation.field_account_move__payment_validation_level2_user_id
msgid "User of the group 'Payment Approval: Level 2 Approvers' who must approve the payment of this document (second step). It is mandatory to approve the payment of a vendor bill. It is defaulted from the partner of the document and can be changed here."
msgstr "Utilisateur du groupe « Bon à payer : validateurs niveau 2 » qui doit valider l'envoi en paiement de ce document (deuxième étape). Il est obligatoire pour valider une facture fournisseur. Il est proposé par défaut depuis le partenaire du document et peut être modifié ici."

#. module: account_payment_validation
#: model:ir.model.fields.selection,name:account_payment_validation.selection__account_move__payment_validation_step__to_validate_level1
msgid "Waiting Approval (Level 1)"
msgstr "En attente niveau 1"

#. module: account_payment_validation
#: model:ir.model.fields.selection,name:account_payment_validation.selection__account_move__payment_validation_step__to_validate_level2
