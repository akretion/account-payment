<odoo>
    <record id="view_move_line_tree_payment_validation" model="ir.ui.view">
        <field name="name">account.move.line.list.payment.validation</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="move_name" position="after">
                <field
                    name="payment_validation_step"
                    widget="badge"
                    optional="show"
                    decoration-warning="payment_validation_step in ('to_validate_level1', 'to_validate_level2')"
                    decoration-success="payment_validation_step == 'validated'"
                />
            </field>
        </field>
    </record>
</odoo>
