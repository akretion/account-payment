<odoo>
    <record id="acquirer_form" model="ir.ui.view">
        <field name="name">acquirer.form.paypal</field>
        <field name="model">payment.acquirer</field>
        <field name="inherit_id" ref="payment.acquirer_form" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="country_ids"]' position='after'>
                <field
                    name="partner_filter_domain"
                    widget="domain"
                    attrs="{'invisible': [('partner_filter_id', '=', False)]}"
                    options="{'model': 'res.partner'}"
                />
                <div class="oe_edit_only oe_inline">
                    Set selection based on a search filter:

                    <field
                        name="partner_filter_id"
                        domain="[('model_id', '=', 'res.partner')]"
                        class="oe_inline"
                        context="{'default_model_id': 'res.partner', 'default_active': False, 'active_test': False}"
                        can_create="true"
                        can_write="true"
                    />
                </div>
           </xpath>
        </field>
    </record>
</odoo>
